{
  "name": "ytmd-deckboard",
  "version": "1.0.0",
  "description": "An extension to interact with Youtube Music Desktop App through a remote control server provided by YTMD",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test",
    "check": "npm run format:check && npm run lint && npm run test",
    "build": "deckboard-kit --build",
    "postinstall": "npm install deckboard-kit-cli --no-save && npx deckboard-kit --install"
  },
  "author": "GSimken",
  "license": "MIT",
  "dependencies": {
    "deckboard-kit": "github:rivafarabi/deckboard-kit",
    "deckboard-kit-cli": "^1.1.3",
    "node-fetch": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
